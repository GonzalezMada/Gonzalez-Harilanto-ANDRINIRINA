{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:4321/fr/",
        "http://localhost:4321/en/",
        "http://localhost:4321/fr/projets",
        "http://localhost:4321/en/projects",
        "http://localhost:4321/fr/blog",
        "http://localhost:4321/en/blog",
        "http://localhost:4321/fr/leadership",
        "http://localhost:4321/en/leadership"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "preset": "lighthouse:recommended",
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
