---
import { getCollection } from 'astro:content';
import SiteLayout from '../../../components/templates/SiteLayout.astro';
import ProjectsGrid from '../../../components/organisms/ProjectsGrid.astro';
import { LOCALES, type Locale } from '../../../i18n/schema';
import { getTranslator } from '../../../lib/i18n';
import { counterpartListPath } from '../../../lib/routing';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const t = getTranslator(lang);

const allProjects = await getCollection('projects');
const projects = allProjects
  .filter((entry) => entry.id.startsWith(`${lang}/`))
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0) || a.data.title.localeCompare(b.data.title))
  .map((entry) => ({
    title: entry.data.title,
    description: entry.data.description,
    technologies: entry.data.technologies,
    externalLink: entry.data.externalLink,
    category: entry.data.category,
  }));

const alternateLinks = {
  fr: counterpartListPath('fr', 'projects'),
  en: counterpartListPath('en', 'projects'),
};
---

<SiteLayout
  locale={lang}
  currentSection="projects"
  alternateLinks={alternateLinks}
  title={`${t('projects.heading')} — ${t('site.title')}`}
  description={t('projects.intro')}
>
  <h1 class="mb-2 font-heading text-3xl font-bold text-foreground">{t('projects.heading')}</h1>
  <p class="mb-8 text-muted-foreground">{t('projects.intro')}</p>
  <ProjectsGrid locale={lang} projects={projects} />
</SiteLayout>
