---
interface Props {
  href: string;
  active?: boolean;
}

const { href, active = false } = Astro.props;
---

<a
  href={href}
  aria-current={active ? 'page' : undefined}
  class:list={[
    'min-h-11 rounded-md px-2 py-1 text-sm font-medium transition-colors inline-flex items-center',
    'hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring',
    active ? 'text-primary underline underline-offset-4' : 'text-foreground',
  ]}
>
  <slot />
</a>
