---
/*
 * Centralised inline-SVG icon set (no runtime dependency). Every glyph draws
 * with `currentColor` and a shared 1.75 stroke, so icons inherit text color
 * and theme automatically. Decorative by default (aria-hidden); pass a `title`
 * to expose an accessible label.
 */
interface Props {
  name: 'sun' | 'moon' | 'arrow-up-right' | 'arrow-left' | 'arrow-up' | 'github' | 'linkedin' | 'mail';
  size?: number;
  class?: string;
  title?: string;
}

const { name, size = 20, class: className = '', title } = Astro.props;
const strokeIcons = new Set(['sun', 'moon', 'arrow-up-right', 'arrow-left', 'arrow-up', 'mail']);
const isStroke = strokeIcons.has(name);
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={isStroke ? 'none' : 'currentColor'}
  stroke={isStroke ? 'currentColor' : 'none'}
  stroke-width={isStroke ? 1.75 : undefined}
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={[className]}
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  aria-label={title}
>
  {title && <title>{title}</title>}
  {
    name === 'sun' && (
      <>
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
      </>
    )
  }
  {name === 'moon' && <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />}
  {name === 'arrow-up-right' && <path d="M7 17 17 7M7 7h10v10" />}
  {name === 'arrow-left' && <path d="M19 12H5M12 19l-7-7 7-7" />}
  {name === 'arrow-up' && <path d="M12 19V5M5 12l7-7 7 7" />}
  {
    name === 'mail' && (
      <>
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="m3 7 9 6 9-6" />
      </>
    )
  }
  {
    name === 'github' && (
      <path d="M12 2C6.48 2 2 6.48 2 12c0 4.42 2.87 8.17 6.84 9.5.5.09.68-.22.68-.48 0-.24-.01-.87-.01-1.7-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02.8-.22 1.65-.33 2.5-.33.85 0 1.7.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85 0 1.34-.01 2.42-.01 2.75 0 .27.18.58.69.48A10.01 10.01 0 0 0 22 12c0-5.52-4.48-10-10-10z" />
    )
  }
  {
    name === 'linkedin' && (
      <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.55C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.72C24 .77 23.2 0 22.22 0z" />
    )
  }
</svg>
