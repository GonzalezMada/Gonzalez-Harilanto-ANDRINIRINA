---
import type { Locale } from '../../i18n/schema';
import { LOCALES } from '../../i18n/schema';
import { getTranslator } from '../../lib/i18n';

interface Props {
  locale: Locale;
  /** Target path for each locale, pre-computed by the page (contracts/routing.md). */
  alternateLinks: Record<Locale, string>;
}

const { locale, alternateLinks } = Astro.props;
const t = getTranslator(locale);
---

<nav aria-label={t('languageSwitcher.label')} class="flex items-center gap-1">
  {
    LOCALES.map((loc) => {
      const isActive = loc === locale;
      return (
        <a
          href={alternateLinks[loc]}
          aria-current={isActive ? 'true' : undefined}
          class:list={[
            'min-h-11 min-w-11 rounded-md px-2 py-1 text-sm font-semibold uppercase transition-colors inline-flex items-center justify-center',
            'focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring',
            isActive
              ? 'bg-primary text-primary-foreground'
              : 'text-foreground hover:text-accent',
          ]}
        >
          {t(`languageSwitcher.${loc}` as const)}
        </a>
      );
    })
  }
</nav>
