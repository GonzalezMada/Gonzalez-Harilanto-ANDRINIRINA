---
import Icon from '../atoms/Icon.astro';

interface Props {
  href: string;
  label: string;
  summary: string;
  featured?: boolean;
}

const { href, label, summary, featured = false } = Astro.props;
---

<a
  href={href}
  class:list={[
    'group relative flex h-full flex-col gap-3 rounded-lg border border-border p-6 transition-[transform,border-color,background-color] duration-200 ease-out hover:-translate-y-0.5 hover:border-primary active:translate-y-0 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring',
    featured ? 'bg-accent/5 md:p-8' : 'bg-surface',
  ]}
>
  <div class="flex items-start justify-between gap-3">
    <h3
      class:list={[
        'font-heading font-semibold text-primary transition-colors group-hover:text-accent',
        featured ? 'text-2xl md:text-3xl' : 'text-xl',
      ]}
    >
      {label}
    </h3>
    <span
      class="mt-1 flex-shrink-0 text-muted-foreground transition-transform duration-200 ease-out group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent"
    >
      <Icon name="arrow-up-right" />
    </span>
  </div>
  <p class:list={['text-muted-foreground', featured ? 'max-w-2xl text-base' : 'text-sm']}>
    {summary}
  </p>
</a>
