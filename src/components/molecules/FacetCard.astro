---
interface Props {
  href: string;
  label: string;
  summary: string;
}

const { href, label, summary } = Astro.props;
---

<a
  href={href}
  class="group flex h-full flex-col gap-2 rounded-lg border border-border bg-background p-6 shadow-sm transition-colors hover:border-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
>
  <h3 class="font-heading text-xl font-semibold text-primary group-hover:text-accent">
    {label}
  </h3>
  <p class="text-sm text-muted-foreground">{summary}</p>
</a>
