---
import Icon from '../atoms/Icon.astro';
import type { Locale } from '../../i18n/schema';
import { getTranslator } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslator(locale);
---

<button
  type="button"
  data-theme-toggle
  class="js-theme-toggle inline-flex min-h-11 min-w-11 items-center justify-center rounded-md text-foreground transition-[color,transform] duration-150 ease-[cubic-bezier(0.23,1,0.32,1)] hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring active:scale-95"
  aria-label={t('nav.toggleTheme')}
>
  <span class="icon-sun"><Icon name="sun" /></span>
  <span class="icon-moon"><Icon name="moon" /></span>
</button>

<style is:global>
  /* Icon reflects the mode you'd switch TO: moon in light, sun in dark.
     Driven purely by the root theme state so the correct glyph paints on the
     first frame (the anti-FOUC head script has already set data-theme). */
  .js-theme-toggle .icon-sun {
    display: none;
  }
  .js-theme-toggle .icon-moon {
    display: inline-flex;
  }
  :root[data-theme='dark'] .js-theme-toggle .icon-sun {
    display: inline-flex;
  }
  :root[data-theme='dark'] .js-theme-toggle .icon-moon {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .js-theme-toggle .icon-sun {
      display: inline-flex;
    }
    :root:not([data-theme='light']) .js-theme-toggle .icon-moon {
      display: none;
    }
  }
</style>

<script>
  function currentTheme(): 'dark' | 'light' {
    const explicit = document.documentElement.dataset.theme;
    if (explicit === 'dark' || explicit === 'light') return explicit;
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }

  // Delegated once on the persistent document so it survives view transitions;
  // the guard prevents a second binding after a full reload on another page.
  const w = window as unknown as { __themeToggleBound?: boolean };
  if (!w.__themeToggleBound) {
    w.__themeToggleBound = true;
    document.addEventListener('click', (event) => {
      const trigger = (event.target as HTMLElement | null)?.closest('[data-theme-toggle]');
      if (!trigger) return;
      const next = currentTheme() === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        /* storage unavailable (private mode); toggle still applies for the session */
      }
    });
  }
</script>
