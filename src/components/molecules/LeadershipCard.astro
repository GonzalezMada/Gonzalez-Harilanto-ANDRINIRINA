---
interface Props {
  organization: string;
  role: string;
  impact: string;
  period?: string;
}

const { organization, role, impact, period } = Astro.props;
---

<article
  class="rounded-lg border border-border border-l-4 border-l-accent bg-surface p-6 transition-colors duration-200 ease-out hover:border-primary hover:border-l-accent"
>
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <h3 class="font-heading text-lg font-semibold text-foreground">{organization}</h3>
    {period && <p class="text-sm font-medium text-accent">{period}</p>}
  </div>
  <p class="mt-1 text-sm font-semibold uppercase tracking-wide text-muted-foreground">{role}</p>
  <p class="mt-3 text-foreground">{impact}</p>
</article>
