---
import type { Locale } from '../../i18n/schema';
import { getTranslator } from '../../lib/i18n';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  technologies: string[];
  externalLink: string;
}

const { locale, title, description, technologies, externalLink } = Astro.props;
const t = getTranslator(locale);
---

<article class="flex h-full flex-col gap-3 rounded-lg border border-border bg-background p-6 shadow-sm">
  <h3 class="font-heading text-lg font-semibold text-foreground">{title}</h3>
  <p class="flex-1 text-sm text-muted-foreground">{description}</p>
  <div>
    <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-muted-foreground">
      {t('projects.technologiesLabel')}
    </p>
    <ul class="flex flex-wrap gap-2">
      {
        technologies.map((tech) => (
          <li class="rounded-full bg-muted px-3 py-1 text-xs font-medium text-foreground">
            {tech}
          </li>
        ))
      }
    </ul>
  </div>
  <a
    href={externalLink}
    target="_blank"
    rel="noopener noreferrer"
    class="mt-2 inline-flex min-h-11 items-center gap-1 text-sm font-semibold text-primary transition-colors hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
  >
    {t('projects.viewProjectLabel')}
    <span class="sr-only">{t('common.externalLinkNewTab')}</span>
  </a>
</article>
