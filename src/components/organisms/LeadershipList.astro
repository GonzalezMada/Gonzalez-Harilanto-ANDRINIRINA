---
import LeadershipCard from '../molecules/LeadershipCard.astro';

interface LeadershipItem {
  organization: string;
  role: string;
  impact: string;
  period?: string;
}

interface Props {
  entries: LeadershipItem[];
}

const { entries } = Astro.props;
---

<div class="flex flex-col gap-4">
  {
    entries.map((entry) => (
      <div class="reveal">
        <LeadershipCard
          organization={entry.organization}
          role={entry.role}
          impact={entry.impact}
          period={entry.period}
        />
      </div>
    ))
  }
</div>
