---
import { TIMELINE } from '../../data/timeline';
import type { Locale } from '../../i18n/schema';
import { getTranslator } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslator(locale);
---

<section aria-labelledby="timeline-heading" class="border-t border-border py-12 md:py-16">
  <h2
    id="timeline-heading"
    class="reveal mb-8 font-heading text-2xl font-semibold text-foreground md:text-3xl"
  >
    {t('home.timelineHeading')}
  </h2>
  <ol class="flex flex-col">
    {
      TIMELINE.map((milestone, index) => (
        <li class="reveal grid grid-cols-[auto_1fr] gap-x-5">
          <div class="flex flex-col items-center" aria-hidden="true">
            <span class="mt-1.5 h-3.5 w-3.5 flex-shrink-0 rounded-full bg-accent ring-4 ring-accent/15" />
            {index < TIMELINE.length - 1 && <span class="w-0.5 flex-1 bg-border" />}
          </div>
          <div class="pb-10">
            <p class="font-heading text-lg font-semibold text-accent">{t(milestone.yearKey)}</p>
            <p class="mt-1 max-w-xl text-foreground">{t(milestone.labelKey)}</p>
          </div>
        </li>
      ))
    }
  </ol>
</section>
