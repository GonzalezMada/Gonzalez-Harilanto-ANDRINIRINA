---
import FacetCard from '../molecules/FacetCard.astro';
import { FACETS } from '../../data/facets';
import type { Locale } from '../../i18n/schema';
import { getTranslator } from '../../lib/i18n';
import { localePath } from '../../lib/routing';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslator(locale);
---

<section aria-labelledby="facets-heading" class="border-t border-border py-12 md:py-16">
  <h2
    id="facets-heading"
    class="reveal mb-8 font-heading text-2xl font-semibold text-foreground md:text-3xl"
  >
    {t('home.facetsHeading')}
  </h2>
  <div class="grid gap-4 md:grid-cols-6">
    {
      FACETS.map((facet, index) => (
        <div class:list={['reveal', index === 0 ? 'md:col-span-6' : 'md:col-span-3']}>
          <FacetCard
            href={localePath(locale, facet.linkSection)}
            label={t(facet.labelKey)}
            summary={t(facet.summaryKey)}
            featured={index === 0}
          />
        </div>
      ))
    }
  </div>
</section>
