---
import Button from '../atoms/Button.astro';
import type { Locale } from '../../i18n/schema';
import { getTranslator } from '../../lib/i18n';
import { localePath, withBase } from '../../lib/routing';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslator(locale);
const photoSrc = withBase('/images/profile.jpg');
const ctaHref = localePath(locale, 'projects');
---

<section class="flex flex-col-reverse items-center gap-8 py-8 md:flex-row md:py-16">
  <div class="flex flex-col items-start gap-4 text-center md:text-left">
    <p class="font-semibold uppercase tracking-wide text-accent">{t('home.heroEyebrow')}</p>
    <h1 class="font-heading text-4xl font-bold text-foreground md:text-5xl">
      {t('home.heroTitle')}
    </h1>
    <p class="max-w-xl text-lg text-muted-foreground">{t('home.heroSubtitle')}</p>
    <Button href={ctaHref} variant="primary">{t('home.heroCta')}</Button>
  </div>
  <img
    src={photoSrc}
    alt={t('home.heroTitle')}
    width="240"
    height="240"
    class="h-60 w-60 flex-shrink-0 rounded-full border-4 border-primary object-cover"
  />
</section>
