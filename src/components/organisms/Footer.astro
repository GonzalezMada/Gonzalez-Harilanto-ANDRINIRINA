---
import Icon from '../atoms/Icon.astro';
import type { Locale } from '../../i18n/schema';
import { getTranslator } from '../../lib/i18n';
import { SITE, socialLinks } from '../../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslator(locale);
const year = new Date().getFullYear();
const socials = socialLinks();

const iconFor: Record<string, 'github' | 'linkedin'> = {
  GitHub: 'github',
  LinkedIn: 'linkedin',
};
---

<footer id="contact" class="scroll-mt-24 border-t border-border bg-muted">
  <div class="mx-auto max-w-6xl px-4 py-12">
    <div class="grid gap-8 md:grid-cols-2">
      <div>
        <h2 class="font-heading text-2xl font-semibold text-foreground md:text-3xl">
          {t('footer.contactHeading')}
        </h2>
        <p class="mt-3 max-w-md text-muted-foreground">{t('footer.contactPrompt')}</p>
        {
          SITE.email && (
            <a
              href={`mailto:${SITE.email}`}
              class="mt-4 inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-primary transition-colors hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
            >
              <Icon name="mail" size={18} />
              {SITE.email}
            </a>
          )
        }
      </div>

      {
        socials.length > 0 && (
          <div class="md:justify-self-end">
            <ul class="flex gap-2">
              {socials.map((social) => (
                <li>
                  <a
                    href={social.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={social.label}
                    class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-md border border-border bg-surface text-foreground transition-[color,border-color,transform] duration-150 ease-out hover:border-primary hover:text-accent active:scale-95 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
                  >
                    <Icon name={iconFor[social.label]} />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>

    <div
      class="mt-10 flex flex-wrap items-center justify-between gap-4 border-t border-border pt-6 text-sm text-muted-foreground"
    >
      <p>&copy; {year} {t('site.title')}</p>
      <a
        href="#main-content"
        class="inline-flex min-h-11 items-center gap-1.5 rounded-md transition-colors hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
      >
        {t('footer.backToTop')}
        <Icon name="arrow-up" size={16} />
      </a>
    </div>
  </div>
</footer>
