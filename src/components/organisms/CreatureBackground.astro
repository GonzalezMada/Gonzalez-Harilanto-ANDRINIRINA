{/*
  Decorative cursor-following particle field, rendered behind the page
  content (z-index: -1, pointer-events: none) so it never blocks reading or
  interaction. Homepage-only: mounted/torn down per navigation via
  astro:page-load / astro:before-swap since the ClientRouter keeps `document`
  alive across client-side transitions but swaps this element's DOM out.
*/}
<div class="creature-viewport" aria-hidden="true">
  <div id="creature"></div>
</div>

<style>
  .creature-viewport {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  /* Anchored in a corner rather than dead-center: the center of the viewport
     is where the reading column/cards live, so a center-anchored creature
     gets fully covered by content the moment you scroll past the hero. The
     corner stays empty margin at essentially every scroll position. */
  #creature {
    position: absolute;
    right: 1.5rem;
    bottom: 1.5rem;
    display: grid;
    grid-template-columns: repeat(13, 1fr);
    grid-template-rows: repeat(13, 1fr);
  }

  #creature div {
    border-radius: 50%;
  }

  @media (prefers-reduced-motion: reduce) {
    .creature-viewport {
      display: none;
    }
  }
</style>

<script>
  import { animate, createTimeline, createTimer, stagger, utils } from 'animejs';

  let cleanupActive: (() => void) | null = null;

  function initCreature() {
    const creatureEl = document.querySelector<HTMLElement>('#creature');
    if (!creatureEl || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const viewport = { w: window.innerWidth * 0.5, h: window.innerHeight * 0.5 };
    const cursor = { x: 0, y: 0 };
    const rows = 13;
    const grid: [number, number] = [rows, rows];
    const from = 'center';
    const scaleStagger = stagger([2, 5], { ease: 'inQuad', grid, from });
    const opacityStagger = stagger([1, 0.1], { grid, from });

    for (let i = 0; i < rows * rows; i++) {
      creatureEl.appendChild(document.createElement('div'));
    }

    const particuleEls = creatureEl.querySelectorAll('div');

    // Particles are sized off this box divided across the grid, so shrinking
    // it shrinks every shape with it — 30x smaller than the original rows*10em
    // (10x, then a further 3x on top).
    utils.set(creatureEl, {
      width: rows / 3 + 'em',
      height: rows / 3 + 'em',
    });

    utils.set(particuleEls, {
      x: 0,
      y: 0,
      scale: scaleStagger,
      opacity: opacityStagger,
      // Hue ~38° matches --color-accent (amber/gold) in both light and dark themes.
      background: stagger([80, 20], {
        grid,
        from,
        modifier: (v: number) => `hsl(38, 70%, ${v}%)`,
      }),
      // Blur radius scaled down with the particles (was [8, 1] against 10em particles).
      boxShadow: stagger([0.8 / 3, 0.1 / 3], {
        grid,
        from,
        modifier: (v: number) => `0px 0px ${utils.round(v, 2)}em 0px var(--color-accent)`,
      }),
      zIndex: stagger([rows * rows, 1], { grid, from, modifier: utils.round(0) }),
    });

    const pulse = () => {
      animate(particuleEls, {
        keyframes: [
          {
            scale: 5,
            opacity: 1,
            delay: stagger(90, { start: 1650, grid, from }),
            duration: 150,
          },
          {
            scale: scaleStagger,
            opacity: opacityStagger,
            ease: 'inOutQuad',
            duration: 600,
          },
        ],
      });
    };

    const mainLoop = createTimer({
      frameRate: 15,
      onUpdate: () => {
        animate(particuleEls, {
          x: cursor.x,
          y: cursor.y,
          delay: stagger(40, { grid, from }),
          duration: stagger(120, { start: 750, ease: 'inQuad', grid, from }),
          ease: 'inOut',
          composition: 'blend',
        });
      },
    });

    const autoMove = createTimeline()
      .add(
        cursor,
        {
          x: [-viewport.w * 0.45, viewport.w * 0.45],
          modifier: (x: number) => x + Math.sin(mainLoop.currentTime * 0.0007) * viewport.w * 0.5,
          duration: 3000,
          ease: 'inOutExpo',
          alternate: true,
          loop: true,
          onBegin: pulse,
          onLoop: pulse,
        },
        0,
      )
      .add(
        cursor,
        {
          y: [-viewport.h * 0.45, viewport.h * 0.45],
          modifier: (y: number) => y + Math.cos(mainLoop.currentTime * 0.00012) * viewport.h * 0.5,
          duration: 1000,
          ease: 'inOutQuad',
          alternate: true,
          loop: true,
        },
        0,
      );

    const manualMovementTimeout = createTimer({
      duration: 1500,
      onComplete: () => autoMove.play(),
    });

    const followPointer = (e: MouseEvent | TouchEvent) => {
      const event = 'touches' in e ? e.touches[0] : e;
      // Offset from the creature's own rest position (its CSS-anchored
      // corner), in viewport coordinates — so the particle cluster actually
      // travels to sit under the cursor, wherever it is on screen. Using
      // clientX/Y (not pageX/Y) keeps this correct while the page is
      // scrolled, since the container is `position: fixed`.
      const anchor = creatureEl.getBoundingClientRect();
      cursor.x = event.clientX - (anchor.left + anchor.width / 2);
      cursor.y = event.clientY - (anchor.top + anchor.height / 2);
      autoMove.pause();
      manualMovementTimeout.restart();
    };

    document.addEventListener('mousemove', followPointer);
    document.addEventListener('touchmove', followPointer);

    cleanupActive = () => {
      document.removeEventListener('mousemove', followPointer);
      document.removeEventListener('touchmove', followPointer);
      mainLoop.pause();
      autoMove.pause();
      manualMovementTimeout.pause();
      creatureEl.replaceChildren();
    };
  }

  // Mount on first load and after every view-transition navigation; tear the
  // previous instance down first since `document` (and its listeners) would
  // otherwise survive the swap and leak/duplicate.
  document.addEventListener('astro:page-load', () => {
    cleanupActive?.();
    cleanupActive = null;
    initCreature();
  });

  document.addEventListener('astro:before-swap', () => {
    cleanupActive?.();
    cleanupActive = null;
  });
</script>
